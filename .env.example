# Neon CLI manages DATABASE_URL and DATABASE_URL_UNPOOLED in .env.local.
# DATABASE_URL is server-only; never add a VITE_ prefix to it.
NEON_AUTH_BASE_URL=https://your-neon-auth-url
NEON_AUTH_JWKS_URL=https://your-neon-auth-url/.well-known/jwks.json
VITE_NEON_AUTH_URL=https://your-neon-auth-url

# Server-only WhatsApp Business Cloud API settings; leave unset until configured.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_LANGUAGE_CODE=en

# Enable only after configuring the server-side WhatsApp credentials above.
VITE_WHATSAPP_NOTIFICATIONS_ENABLED=false
